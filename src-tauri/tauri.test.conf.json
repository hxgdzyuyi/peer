{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Peer — desktop tests",
        "width": 1440,
        "height": 940,
        "minWidth": 950,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "alwaysOnTop": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "main",
        {
          "identifier": "desktop-tests",
          "windows": ["main"],
          "permissions": [
            "wdio:default",
            "clipboard-manager:allow-read-text",
            "core:window:allow-set-focus",
            "core:window:allow-set-size"
          ]
        }
      ]
    }
  }
}
